{
  "name": "effectra-desktop",
  "productName": "Effectra",
  "version": "1.3.0",
  "description": "Effectra – Projekte, Aufgaben und Fortschritt fürs Team.",
  "main": "main.js",
  "author": "Effectra",
  "license": "UNLICENSED",
  "scripts": {
    "copy-web": "node copy-web.js",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "app.effectra.desktop",
    "productName": "Effectra",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "web/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Effectra-Setup-${version}.exe",
      "createDesktopShortcut": true,
      "shortcutName": "Effectra"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "moaed-macher",
        "repo": "effectra"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
